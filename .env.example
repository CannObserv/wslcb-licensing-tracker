# Environment variables consumed by the WSLCB Licensing Tracker.
# Copy to .env for local development (the repo .env is gitignored).
# Production values live in /etc/wslcb-licensing-tracker/.env (systemd EnvironmentFile).
#
# Every name carries the CO_WSLCB_LICENSING_TRACKER_ prefix (#204), enforced by
# tests/test_env_prefix.py. The pre-#204 names (the suffix alone, or WSLCB_<suffix>)
# are no longer read (#244): set alone, they leave the variable unset.
# Exceptions, named by someone else: GOOGLE_APPLICATION_CREDENTIALS (GCS SDK; set
# by wslcb-backup.service), CREDENTIALS_DIRECTORY (systemd), PYTHONUNBUFFERED and
# PYTHONDONTWRITEBYTECODE (Python; set by the units). Not this project's:
# GH_TOKEN* (gh CLI), ANTHROPIC_API_KEY (curating-context), TYPESAFE_API_KEY
# (docs/research/ scripts only).

# ── Application ──────────────────────────────────────────────────────
# PostgreSQL connection URL (SQLAlchemy async driver).
CO_WSLCB_LICENSING_TRACKER_DATABASE_URL=postgresql+asyncpg://wslcb:wslcb@localhost/wslcb

# Root of the snapshot/diff archive tree. Defaults to <repo>/data when unset.
#CO_WSLCB_LICENSING_TRACKER_DATA_DIR=/home/exedev/wslcb-licensing-tracker/data

# Short git SHA used for static-asset cache busting. Set by the systemd unit
# in production (see infra/wslcb-web.service); unset in dev → "dev".
#CO_WSLCB_LICENSING_TRACKER_BUILD_ID=

# Contact email in the User-Agent every outbound client sends (#243):
#   CannObserv-wslcb-licensing-tracker/<version> (+https://github.com/CannObserv/wslcb-licensing-tracker; <email>)
# Required, syntax-checked only. Without it, the WSLCB scrape, address validation
# and Jev refuse to send. Check-ins and GCS backup/restore still send, without
# the contact, and log an ERROR. Set it in /etc/wslcb-licensing-tracker/backup.env too.
CO_WSLCB_LICENSING_TRACKER_CONTACT_EMAIL=code@cannabis.observer

# ── Address validation (optional) ────────────────────────────────────
# Master switch for the address-validator integration ("1"/"true"/"yes").
#CO_WSLCB_LICENSING_TRACKER_ENABLE_ADDRESS_VALIDATION=1
# API key for https://address-validator.exe.xyz:8000
#CO_WSLCB_LICENSING_TRACKER_ADDRESS_VALIDATOR_API_KEY=

# ── Admin auth (dev only — NEVER set in production) ──────────────────
# Fallback identity when exe.dev proxy headers are absent, e.g. when
# hitting uvicorn directly on localhost.
#CO_WSLCB_LICENSING_TRACKER_ADMIN_DEV_EMAIL=you@example.com
#CO_WSLCB_LICENSING_TRACKER_ADMIN_DEV_USERID=dev

# ── Backup (#185) ────────────────────────────────────────────────────
# Read by wslcb-backup.service from /etc/wslcb-licensing-tracker/backup.env —
# never from the app .env. No secrets here: the GCS key and the check-in key
# reach the unit as systemd credentials. See docs/RECOVERY.md.
#CO_WSLCB_LICENSING_TRACKER_BACKUP_BUCKET=co-gcs-wslcb-backup
#CO_WSLCB_LICENSING_TRACKER_ARCHIVE_BUCKET=co-gcs-wslcb-archive
# Object-key prefix; defaults to the hostname.
#CO_WSLCB_LICENSING_TRACKER_BACKUP_PREFIX=
# co-status dead-man check-in; all three (with the checkin-key credential) or none.
#CO_WSLCB_LICENSING_TRACKER_BACKUP_CHECKIN_BASE_URL=http://status:9000
#CO_WSLCB_LICENSING_TRACKER_BACKUP_MONITOR_ID=

# ── Scrape check-in (#196) ───────────────────────────────────────────
# Read by wslcb-task@scrape.service from /etc/wslcb-licensing-tracker/.env.
# All three (with the drop-in's checkin-key credential) or none. No secret
# here. See docs/MONITORING.md § Scrape check-in.
#CO_WSLCB_LICENSING_TRACKER_SCRAPE_CHECKIN_BASE_URL=http://status:9000
#CO_WSLCB_LICENSING_TRACKER_SCRAPE_MONITOR_ID=

# Relay inbox for `wslcb ingest import-relayed` (#201): where the operator's
# Mac drops captures while WSLCB blocks this host (#198). Keep it outside
# data/, which the backup mirrors. Default: ~/wslcb-relay-inbox.
#CO_WSLCB_LICENSING_TRACKER_RELAY_INBOX=
# Read on the operator's Mac by scripts/relay/relay-capture.sh, never on this
# host (docs/RELAY.md): the VM's ssh destination (required; the plist sets it),
# the page to fetch, and the tracker checkout relative to the VM's home. The
# script reads RELAY_INBOX too, relative to the VM's home.
#CO_WSLCB_LICENSING_TRACKER_RELAY_HOST=wslcb-licensing-tracker.exe.xyz
#CO_WSLCB_LICENSING_TRACKER_RELAY_URL=https://licensinginfo.lcb.wa.gov/EntireStateWeb.asp
#CO_WSLCB_LICENSING_TRACKER_RELAY_CHECKOUT=wslcb-licensing-tracker

# ── Entity classification (Jev, optional) ────────────────────────────
# Minimum Jev confidence (0..1) that wins over the regex at resolution
# (#206). Read when entities are re-resolved (`wslcb db reclassify-entities`),
# so a change takes effect at the next run. Invalid → warning + 0.7.
#CO_WSLCB_LICENSING_TRACKER_JEV_CONFIDENCE_THRESHOLD=0.7
# Gates Jev *calls* only (#207): post-scrape/post-import passes, the weekly
# timer and `wslcb db classify-entities`. Off by default. Stored answers keep
# resolving either way; roll them back with `wslcb db ignore-jev`.
#CO_WSLCB_LICENSING_TRACKER_ENABLE_JEV_CLASSIFICATION=false
# TypeSafe API key. With the flag on and this empty, every run records
# `missing_api_key` and the weekly check-in alerts. Never logged.
#CO_WSLCB_LICENSING_TRACKER_TYPESAFE_API_KEY=
# Pinned Jev model, stored on every row. Changing it re-queries nothing by
# itself; `classify-entities --refresh-model <old>` does.
#CO_WSLCB_LICENSING_TRACKER_JEV_MODEL=jev-1.14.0
# Names sent per automatic run (post-ingest passes, weekly timer). The CLI's
# --limit overrides it for the one-off backfill. Invalid or < 1 → 5000.
#CO_WSLCB_LICENSING_TRACKER_JEV_MAX_NAMES_PER_RUN=5000
# The weekly classification run's co-status monitor (docs/MONITORING.md
# § Entity classification check-in). The key is the unit's checkin-key
# credential, never an env var.
#CO_WSLCB_LICENSING_TRACKER_CLASSIFY_CHECKIN_BASE_URL=http://status:9000
#CO_WSLCB_LICENSING_TRACKER_CLASSIFY_MONITOR_ID=

# ── Tests ────────────────────────────────────────────────────────────
# Separate PostgreSQL database for the test suite (required for PG tests;
# tests are skipped when unset).
CO_WSLCB_LICENSING_TRACKER_TEST_DATABASE_URL=postgresql+asyncpg://wslcb:wslcb@localhost/wslcb_test
# CI only: turn a missing test database URL into a hard failure.
#CO_WSLCB_LICENSING_TRACKER_REQUIRE_PG_TESTS=1
