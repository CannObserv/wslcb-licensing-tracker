{
  "env": {
    "SOCRATICODE_SPEC": "socraticode@1.14.0"
  },
  "skillOverrides": {
    "auditing-ci-cost": "user-invocable-only",
    "init-socraticode": "user-invocable-only",
    "maintaining-host-disk": "user-invocable-only",
    "orchestrating-issue-backlog": "user-invocable-only",
    "coordinating-epics": "name-only",
    "dispatching-parallel-agents": "name-only",
    "enforcing-architecture": "name-only",
    "managing-skills": "name-only",
    "subagent-driven-development": "name-only",
    "using-mayfly-chat": "name-only",
    "writing-skills": "name-only",
    "code-review": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "ship-local": "user-invocable-only",
    "steward": "user-invocable-only",
    "claude-api": "name-only",
    "run": "name-only",
    "simplify": "name-only",
    "workflow-authoring": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/socraticode-reminder.sh\" # socraticode-prefetch",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/socraticode-health.sh\" # socraticode-health",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/skills-submodule-update.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'H=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/context-budget-guard.sh\"; [ -f \"$H\" ] && exec bash \"$H\"; exit 0'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(/home/exedev/.claude/projects/**)"
    ]
  }
}
