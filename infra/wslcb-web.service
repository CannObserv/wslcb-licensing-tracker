[Unit]
Description=WSLCB Licensing Tracker Web App
After=network.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/wslcb-licensing-tracker
# '+' prefix runs as root (bypasses User=); safe.directory needed because repo is owned by exedev.
ExecStartPre=+/bin/bash -c '/usr/bin/git config --global --add safe.directory /home/exedev/wslcb-licensing-tracker 2>/dev/null; echo BUILD_ID=$(/usr/bin/git -C /home/exedev/wslcb-licensing-tracker rev-parse --short HEAD) > /run/wslcb-build-id'
ExecStart=/home/exedev/wslcb-licensing-tracker/.venv/bin/uvicorn wslcb_licensing_tracker.app:app --host 0.0.0.0 --port 8000 --log-config /home/exedev/wslcb-licensing-tracker/src/wslcb_licensing_tracker/log_config.json
# Retry loop: poll /api/v1/health up to 20 times (60 s) after start.
# Fails the unit if the app never becomes healthy, triggering Restart=always.
ExecStartPost=/bin/bash -c 'for i in $(seq 1 20); do sleep 3 && /usr/bin/curl -sf http://localhost:8000/api/v1/health && exit 0; done; exit 1'
Restart=always
RestartSec=5
# Memory reservation (#175). This host has no swap and shares its memory with
# interactive agent sessions, whose processes inherit oom_score_adj=-1000 from
# exe.dev's sshd (/exe.dev/bin/sshd, itself -1000 under PID 1) and so can never
# be OOM-killed. Under exhaustion the kernel
# would pick this service instead. MemoryLow keeps the app's working set off
# the reclaim list under pressure; 256M is ~3x the measured steady state
# (84.9 MB RSS, 66 MB charged to the cgroup on 2026-09-18), leaving room for
# request bursts without reserving memory the host cannot spare. Do NOT
# re-derive this from the 75 MB figure in #175 — that number is a pinned
# SocratiCode server's peak, an unrelated process. OOMScoreAdjust moves
# it well down the killer's ranking without making it unkillable. -700 is
# calibrated, not arbitrary: it puts this service's oom_score at ~208, clear of
# the +300 earlyoom 1.7 adds to a --prefer match, and below every killable
# adj-0 process (~666+), so either killer takes one of those first. At adj 0 it
# read ~674 and would have been the first thing chosen. The session's own
# node/npm are NOT among them: at -1000 neither killer can take them (#178).
#
# MemoryLow REQUIRES infra/system.slice.d-10-wslcb-memory.conf to be installed.
# cgroup v2 caps effective protection at the ancestors', system.slice ships
# with memory.low = 0, and this VM's cgroup2 is mounted without
# memory_recursiveprot — so without that drop-in this line is silently inert.
MemoryLow=256M
OOMScoreAdjust=-700
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/wslcb-licensing-tracker/.env
EnvironmentFile=-/run/wslcb-build-id

[Install]
WantedBy=multi-user.target
